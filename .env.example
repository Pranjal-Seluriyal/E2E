# E2EE Microservice Configuration Example

# API configuration
PROJECT_NAME="Reddit-Insta E2EE Service"
DEBUG=true
API_V1_STR="/api/v1"

# Database configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=e2e_db
POSTGRES_PORT=5432
# Database URL will be constructed dynamically by the application or overridden here
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/e2e_db

# Security & Authentication
# Secret key for service-to-service validation or JWT verification
JWT_SECRET_KEY=supersecretjwtkeyforverifyingincomingusers
ALGORITHM=HS256

# Redis configuration (if needed for websocket scaling or rate limiting)
REDIS_URL=redis://localhost:6379/0

# CORS Configuration (comma-separated list of origins, or * for all)
CORS_ORIGINS="*"

# Service-to-Service Asymmetric Authentication
# PEM-encoded Ed25519 public key of the Chat Service for validating workload JWTs
CHAT_SERVICE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAGb9ECWmEzf6gWWEtMAuxgbcHstK1dXYXcH27Ji3RCxo=\n-----END PUBLIC KEY-----"
SERVICE_JWT_ISSUER="chat-identity-provider"

